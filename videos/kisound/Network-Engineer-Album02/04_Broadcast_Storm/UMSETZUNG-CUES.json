 "chapters": [
  {
   "id": "C01",
   "title": "Offene Kette",
   "start": 0,
   "end": 15.58,
   "action": "SW1–SW2–SW3 als offene Kette; die beiden Port-24-Enden bleiben getrennt. Ein loses Kabel."
  },
  {
   "id": "C02",
   "title": "Falscher Port",
   "start": 15.58,
   "end": 22.3,
   "action": "Der Fehlpatch rastet an SW3 Gi1/0/24 ein und schliesst den Ring in VLAN 120. STP ist dort aus."
  },
  {
   "id": "C03",
   "title": "B-001",
   "start": 22.3,
   "end": 43.96,
   "action": "H1 fragt per ARP-Broadcast nach 192.0.2.1. SW1 flutet: eine Kopie in jede Ringrichtung."
  },
  {
   "id": "C04",
   "title": "Kopien wachsen",
   "start": 43.96,
   "end": 66.52,
   "action": "Die Kopien kehren zurück und werden erneut geflutet; jeder neue Broadcast kreist mit. CPU rot, Management weg."
  },
  {
   "id": "C05",
   "title": "Alle Lampen grün",
   "start": 66.52,
   "end": 86.52,
   "action": "Grüne Linklampen über vollen Queues. Die H1-MAC springt zwischen den Ringports. Nichts kommt durch."
  },
  {
   "id": "C06",
   "title": "Broadcast Storm",
   "start": 86.52,
   "end": 110.54,
   "action": "Kein Root, kein Blocking: der Ring frisst die Leitungen, Puffer verwerfen."
  },
  {
   "id": "C07",
   "title": "Loop · Flood",
   "start": 110.54,
   "end": 130.06,
   "action": "Eine volle Ringrunde, Flooding an jedem Abzweig, Verluste bei unverändertem Link."
  },
  {
   "id": "C08",
   "title": "Zieh das Kabel",
   "start": 130.06,
   "end": 137.38,
   "action": "Der Auftrag zur Suche. Das Suchlicht fährt über den Ring."
  },
  {
   "id": "C09",
   "title": "Console-Weg",
   "start": 137.38,
   "end": 161.38,
   "action": "In-band-Login scheitert; die serielle Console führt zu SW3. Gi1/0/24 ist der falsche Ringabschluss."
  },
  {
   "id": "C10",
   "title": "Ein Port down",
   "start": 161.38,
   "end": 166.56,
   "action": "shutdown an SW3 Gi1/0/24. Der Ring ist offen."
  },
  {
   "id": "C11",
   "title": "Die Flut zieht ab",
   "start": 166.56,
   "end": 186.72,
   "action": "Restliche Kopien laufen aus, Queues leeren sich, MAC-Lernen beruhigt sich."
  },
  {
   "id": "C12",
   "title": "Stille",
   "start": 186.72,
   "end": 208.8135,
   "action": "Management antwortet, Unicast-Test erfolgreich. Folgearbeit: STP für VLAN 120."
  }
 ],
