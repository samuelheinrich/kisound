  },
  {
   "id": "C07",
   "title": "Rücknahme",
   "start": 136.32,
   "end": 158.88,
   "action": "Diff + shutdown, gezielt no shutdown bei 147,88 s; erst Link, dann Route."
  },
  {
   "id": "C08",
   "title": "Service-Test",
   "start": 158.88,
   "end": 166.98,
   "action": "P-O1 vom Client bis zum Ziel: TLS geprüft, HTTP 200."
  },
  {
   "id": "C09",
   "title": "Vorher gebaut",
   "start": 166.98,
   "end": 196.88,
   "action": "Backup, Rollback, getrennter Zugang; speichern erst nach den Tests."
  },
  {
   "id": "C10",
   "title": "Final Chorus",
