   "action": "Gi0/0/1 ist seit Filmbeginn administrativ down; In-band-SSH bleibt ohne Antwort."
  },
  {
   "id": "C02",
   "title": "Der getrennte Weg",
   "start": 22.58,
   "end": 46.2,
   "action": "Hinter dem Rack: Managementtrasse, Console-Server und serieller Kanal 7 – schon vorher gebaut."
  },
  {
   "id": "C03",
   "title": "SSH wartet",
   "start": 46.2,
   "end": 66.78,
   "action": "Timeout auf dem Produktionspfad, Dashboard steht still, CHG-2088 als Ursache."
  },
  {
   "id": "C04",
   "title": "Console",
   "start": 66.78,
   "end": 90.08,
   "action": "SSH zum Console-Server im Managementnetz, picocom 9600/8N1, R-EDGE# über Kanal 7."
  },
  {
   "id": "C05",
   "title": "Out of Band",
   "start": 90.08,
   "end": 117.8,
   "action": "Eine Tür bleibt offen: der schmale Weg, während der grosse Weg schweigt."
  },
  {
