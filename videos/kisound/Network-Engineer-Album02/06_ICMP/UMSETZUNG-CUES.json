 "chapters": [
  {
   "id": "C01",
   "title": "Mehr als ein Ping",
   "start": 0,
   "end": 25.76,
   "action": "Ein Büro in Zürich, ein Laptop, ein Server in New York; dazwischen Frankfurt und der Atlantik."
  },
  {
   "id": "C02",
   "title": "Echo",
   "start": 25.76,
   "end": 43.88,
   "action": "ping -c 1: E-01 Echo Request 8/0 nach New York, E-02 Echo Reply 0/0 zurück, 92,4 ms."
  },
  {
   "id": "C03",
   "title": "Der Host antwortet",
   "start": 43.88,
   "end": 60.6,
   "action": "D antwortet auf Echo, ein UDP-Socket bleibt geschlossen – ein Ping ist kein Dienstnachweis."
  },
  {
   "id": "C04",
   "title": "Hör hin",
   "start": 60.6,
   "end": 70.56,
   "action": "Fünf Vorgänge auf einer Strecke; Fehlerantworten tragen ein Zitat des Originals."
  },
  {
   "id": "C05",
   "title": "Don’t Fragment",
   "start": 70.56,
   "end": 86.62,
   "action": "P-M1: 1500 Byte, DF=1. Der Tunnel in Frankfurt hat MTU 1400 – Drop."
  },
  {
   "id": "C06",
   "title": "Fragmentation Needed",
   "start": 86.62,
   "end": 98.08,
   "action": "I-M1 ICMP 3/4, Next-Hop MTU 1400 → PMTU-Eintrag, P-M2 neu mit 1400 Byte. Gegenbeispiel: gefiltertes ICMP."
  },
  {
   "id": "C07",
   "title": "Hook",
   "start": 98.08,
   "end": 112.66,
   "action": "Echo Reply, Time Exceeded, Redirect – Vorschau auf die nächsten Stationen."
  },
  {
   "id": "C08",
   "title": "Traceroute",
   "start": 112.66,
   "end": 127.62,
   "action": "T-1 endet am Heimrouter, T-2 in Frankfurt, T-3 in New York; 11/0, 11/0, 3/3."
  },
  {
   "id": "C09",
   "title": "Port Unreachable",
   "start": 127.62,
   "end": 136.54,
   "action": "D erreicht, UDP-Port 33436 nicht belegt: Type 3 Code 3."
  },
  {
   "id": "C10",
   "title": "Stimme aus der Leitung",
   "start": 136.54,
   "end": 152.2,
   "action": "Die geöffneten Typ/Code-Karten; P-M2 passiert den Tunnel und kommt in New York an."
  },
  {
   "id": "C11",
   "title": "Redirect",
   "start": 152.2,
   "end": 169.62,
   "action": "G1 leitet zu G2 weiter und meldet 5/1, Gateway 192.0.2.2. H prüft, dann direkt über G2."
  },
  {
   "id": "C12",
   "title": "Jetzt hörst du hin",
   "start": 169.62,
   "end": 216.7735,
   "action": "Alle fünf Vorgänge auf der Kugel; Request und Reply; zurück ins Büro."
  }
 ],
