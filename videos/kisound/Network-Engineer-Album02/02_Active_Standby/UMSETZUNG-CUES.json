 "chapters": [
  {
   "id": "C01",
   "title": "Gemeinsame Adresse",
   "start": 0,
   "end": 12.4,
   "action": "Zwei gleiche FortiGates, eine LAN-Adresse 192.0.2.1. Nur A trägt den Datenstrom."
  },
  {
   "id": "C02",
   "title": "Ich trag den Traffic",
   "start": 12.4,
   "end": 23.72,
   "action": "A verarbeitet die Flows; S-17 entsteht und wird als Zustandskopie nach B synchronisiert."
  },
  {
   "id": "C03",
   "title": "Heartbeat und Sync",
   "start": 23.72,
   "end": 67.42,
   "action": "ha1 trägt zwei getrennte Vorgänge: Heartbeat und Session-Sync. B hört zu und hält den Stand."
  },
  {
   "id": "C04",
   "title": "Active · Standby",
   "start": 67.42,
   "end": 89.1,
   "action": "A Primary/Active, B Secondary/Standby. Die einzige HA-Leitung ha1 wird freigestellt."
  },
  {
   "id": "C05",
   "title": "Der Link ist weg",
   "start": 89.1,
   "end": 92.62,
   "action": "ha1 bricht. A arbeitet weiter; Bs Peer-Timer läuft 3,52 s aus."
  },
  {
   "id": "C06",
   "title": "Beide Active",
   "start": 92.62,
   "end": 111.38,
   "action": "B wird lokal Primary. Zwei Datenpfade treffen auf denselben Adressring; Sessions brechen."
  },
  {
   "id": "C07",
   "title": "Isoliert",
   "start": 111.38,
   "end": 117.9,
   "action": "Externes Fencing: nur As zwei Produktionsanschlüsse werden an den Switches abgeschaltet. Präferenzen neu gesetzt."
  },
  {
   "id": "C08",
   "title": "Rollen neu",
   "start": 117.9,
   "end": 125.58,
   "action": "ha1 repariert, Wahl: B Primary. Bs Zustand ist Autorität für die Synchronisation."
  },
  {
   "id": "C09",
   "title": "Ein Pfad",
   "start": 125.58,
   "end": 139.86,
   "action": "in-sync. As Links erst nach der Prüfung wieder frei; A bleibt Secondary."
  },
  {
   "id": "C10",
   "title": "Active · Standby, neu",
   "start": 139.86,
   "end": 171.92,
   "action": "B Active, A Standby. Neuer Testflow durch B, Sync jetzt B→A."
  },
  {
   "id": "C11",
   "title": "Neuer Test",
   "start": 171.92,
   "end": 189.66,
   "action": "Kontrollierter TCP-Test durch B; beide Consoles: B Primary, A Secondary, in-sync."
  },
  {
   "id": "C12",
   "title": "Klarer Pfad",
   "start": 189.66,
   "end": 203.1735,
   "action": "Outro: Active auf B, Standby auf A. Blende."
  }
 ],
