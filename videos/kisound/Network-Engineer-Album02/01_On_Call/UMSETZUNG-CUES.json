 "chapters": [
  {
   "id": "C01",
   "title": "Nacht",
   "start": 0,
   "end": 16.58,
   "action": "Die Stadt schläft; ein einziges Fenster leuchtet. Telefon dunkel, Monitor in Bereitschaft."
  },
  {
   "id": "C02",
   "title": "Display wird hell",
   "start": 16.58,
   "end": 30.02,
   "action": "Alarm 02:17. INCIDENT-2042 erscheint neben dem Bereitschaftsnamen. Die Person setzt sich auf."
  },
  {
   "id": "C03",
   "title": "Rackgang",
   "start": 30.02,
   "end": 44.56,
   "action": "Diagnoseoberfläche offen. Durch den Monitor in den Rackgang bis an R-EDGE; die falsche ACL ist schon gebunden."
  },
  {
   "id": "C04",
   "title": "Alles ist weg",
   "start": 44.56,
   "end": 75.4,
   "action": "Ein ungenaues Ticket wird präzise: SITE-2, Client 192.0.2.10, Beginn nach CHG-2042. TEST-A: drei Dienste Timeout, CTRL-D antwortet."
  },
  {
   "id": "C05",
   "title": "Genauer fragen",
   "start": 75.4,
   "end": 89.32,
   "action": "Keine Änderung auf Verdacht. Client, Zeit und Ziel stehen fest; ein einzelner Diagnose-SYN wird vorbereitet."
  },
  {
   "id": "C06",
   "title": "Ich folg dem Signal",
   "start": 89.32,
   "end": 120.12,
   "action": "F-A1 in Zeitlupe durch R-EDGE: Port, Eingangsprüfung, gültige Route – Verwerfung an QUARANTINE Regel 10."
  },
  {
   "id": "C07",
   "title": "Die Spur",
   "start": 120.12,
   "end": 135.68,
   "action": "Drei Belege: Route korrekt, Binding falsch, Counter 40→41 samt Log. Gateway-Test ist kein Anwendungstest."
  },
  {
   "id": "C08",
   "title": "Erst verstehen",
   "start": 135.68,
   "end": 148.78,
   "action": "Diff gegen den Vorzustand, Vorschau, dann genau ein Eingriff: no ip access-group QUARANTINE out um 146,82 s."
  },
  {
   "id": "C09",
   "title": "Derselbe Test",
   "start": 148.78,
   "end": 184.28,
   "action": "Derselbe curl-Befehl, neue Verbindung F-A2: Handshake, TLS, HTTP 200. Danach APP-B, APP-C und CTRL-D."
  },
  {
   "id": "C10",
   "title": "Ticket geschlossen",
   "start": 184.28,
   "end": 199.04,
   "action": "Ursache, Eingriff, Verifikation. Telefon gesperrt, Fenster dunkel."
  },
  {
   "id": "C11",
   "title": "Die Stadt weiss nichts",
   "start": 199.04,
   "end": 216.7735,
   "action": "Der geprüfte Serviceweg unter den Strassen, neue Transaktionen in den Diensthallen, Blende."
  }
