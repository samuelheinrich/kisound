 "chapters": [
  {
   "id": "C01",
   "title": "Zwei Flows, ein Draht",
   "start": 0,
   "end": 13.3,
   "action": "RTP links, Backup rechts; beide schon klassifiziert. Gemeinsamer Engpass 100 Mbit/s."
  },
  {
   "id": "C02",
   "title": "Quality of Service",
   "start": 13.3,
   "end": 31.2,
   "action": "EF/46 und Best Effort/0 – nicht alles gleich. Die Markierung wirkt nur mit der passenden Policy."
  },
  {
   "id": "C03",
   "title": "Die Policy",
   "start": 31.2,
   "end": 58.1,
   "action": "INGRESS, CHILD, PARENT: Klassifizierung, Markierung, Policer, Priority, Fair-Queue, Shaper."
  },
  {
   "id": "C04",
   "title": "Bulk",
   "start": 58.1,
   "end": 88.88,
   "action": "TCP zählt Bytes; ein gespeichertes Verlustfenster zeigt Q-B17, Q-B18 ist eine neue Retransmission."
  },
  {
   "id": "C05",
   "title": "Policing",
   "start": 88.88,
   "end": 104.14,
   "action": "RTP-Burst 1,2 Mbit/s: 1,0 konform, 0,2 Überschuss wird endgültig verworfen."
  },
  {
   "id": "C06",
   "title": "Shaping",
   "start": 104.14,
   "end": 126.1,
   "action": "Der Parent-Shaper hält Q-BS im Puffer und gibt es später genau einmal aus."
  },
  {
   "id": "C07",
   "title": "Classify · Mark · Queue",
   "start": 126.1,
   "end": 141.1,
   "action": "Ein neuer RTP-Frame durch Klassifizierung, Markierung und Priority-Queue."
  },
  {
   "id": "C08",
   "title": "Schedule · Shape · Send",
   "start": 141.1,
   "end": 151.15,
   "action": "Scheduler-Wahl, Shaper-Budget, Serialisierung am gemeinsamen Port."
  },
  {
   "id": "C09",
   "title": "Final Chorus",
   "start": 151.15,
   "end": 195.2,
   "action": "Beide Klassen aktiv, Policy unverändert; RTP-Empfang und steigende TCP-ACKs."
  },
  {
   "id": "C10",
   "title": "Hörst du mich?",
   "start": 195.2,
   "end": 239.0535,
   "action": "Klar und deutlich – der Transfer läuft noch. Passt."
  }
 ],
