 "chapters": [
  {
   "id": "C01",
   "title": "Bei mir geht’s",
   "start": 0,
   "end": 24.96,
   "action": "Zwei Aussagen, zwei Standorte: der Vergleichspfad antwortet, der betroffene Client wartet hinter dem 100-Mbit/s-Uplink."
  },
  {
   "id": "C02",
   "title": "Capture läuft",
   "start": 24.96,
   "end": 33.22,
   "action": "Vorbereitete SPAN-Sessions auf SW-A und SW-B füllen BEFORE und AFTER."
  },
  {
   "id": "C03",
   "title": "Fremde Flows",
   "start": 33.22,
   "end": 70.34,
   "action": "Thesen im Chat, Mirror-Kopien in der Liste; der betroffene Tuple wird freigestellt."
  },
  {
   "id": "C04",
   "title": "Der richtige Stream",
   "start": 70.34,
   "end": 89.32,
   "action": "Displayfilter auf Client und Ziel, dann tcp.stream == 7 – Frames werden ausgeblendet, nicht gelöscht."
  },
  {
   "id": "C05",
   "title": "Zeig mir, was passiert",
   "start": 89.32,
   "end": 105.94,
   "action": "Paket für Paket durch die Schichten; Seq 10801, 12001, 13201."
  },
  {
   "id": "C06",
   "title": "Retransmission",
   "start": 105.94,
   "end": 124.68,
   "action": "O-101 geht raus und kommt nie an; O-102 trägt denselben Bytebereich. Der zweite Capture grenzt ein."
  },
  {
   "id": "C07",
   "title": "TLS bleibt dicht",
   "start": 124.68,
   "end": 137.3,
   "action": "Ohne Secrets kein Klartext; ein RST ist ein Hinweis, kein Urteil."
  },
  {
   "id": "C08",
   "title": "Der Befund",
   "start": 137.3,
   "end": 139.8,
   "action": "Bytebereich fehlt AFTER, +18 Output-Drops am SW-A-Uplink, null Capture-Drops."
  },
  {
   "id": "C09",
   "title": "Kontrollierter Versuch",
   "start": 139.8,
   "end": 157.26,
   "action": "Bulk-Quelle 95 → 20 Mbit/s, Uplink bleibt 100 Mbit/s. Derselbe Test mit neuer Verbindung."
  },
  {
   "id": "C10",
   "title": "Die Antwort kommt zurück",
   "start": 157.26,
   "end": 168.22,
   "action": "HTTP 200 am Testclient, beidseitige Segmente, Drop-Delta 0."
  },
  {
   "id": "C11",
   "title": "Capture stoppen",
   "start": 168.22,
   "end": 187.9,
   "action": "Mitschnitte gestoppt und gesichert, Bericht mit Ursache und Versuch."
  },
  {
   "id": "C12",
   "title": "Warum",
   "start": 187.9,
   "end": 195.7335,
   "action": "Der dokumentierte Verlust an der überlasteten Ausgangsqueue."
  }
 ],
