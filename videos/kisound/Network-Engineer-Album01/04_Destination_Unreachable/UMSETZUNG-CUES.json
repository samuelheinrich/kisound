 "chapters": [
  {
   "id": "C01",
   "title": "Pulse",
   "start": 0,
   "end": 30.74,
   "action": "Ein Glossar der Stille: Destination unreachable, Time exceeded, No reply, Blackhole, TTL, Traceroute – jedes als echtes Ereignis im Backbone."
  },
  {
   "id": "C02",
   "title": "Ein Signal in den Kern",
   "start": 30.74,
   "end": 45.36,
   "action": "Ein Echo Request überquert die Kante und verschwindet nach Hop 3. Kein Alarm, keine Antwort."
  },
  {
   "id": "C03",
   "title": "Wo ist das Paket?",
   "start": 45.36,
   "end": 69.36,
   "action": "Nebelkarte. Die Blackhole-Route wächst von /32 auf /24, ein zweiter Host verschwindet. Nochmals senden – Fall. Von R2 kommt ein lautes Unreachable: kein Route für Site C."
  },
  {
   "id": "C04",
   "title": "Nacht",
   "start": 69.36,
   "end": 81.72,
   "action": "Fahrt durch den Backbone, Traceroute läuft."
  },
  {
   "id": "C05",
   "title": "Traceroute",
   "start": 81.72,
   "end": 110.18,
   "action": "Hop für Hop. Firewall still: 0 Treffer im Log. Ein fehlendes Präfix bei R2. Echo Request ohne Reply. Metriken wechseln, der Weg führt trotzdem in R4."
  },
  {
   "id": "C06",
   "title": "Break",
   "start": 110.18,
   "end": 132.34,
   "action": "TTL expired · Next hop gone · Silent gateway · Moving on · ICMP · No reply · Packets fall · Signals die."
  },
  {
   "id": "C07",
   "title": "Final Hook",
   "start": 132.34,
   "end": 163.8,
   "action": "Dieselben Fragen, grösseres Loch."
  },
  {
   "id": "C08",
   "title": "Finale",
   "start": 163.8,
   "end": 172.46,
   "action": "Dreimal Destination unreachable."
  },
  {
   "id": "C09",
   "title": "Leerer Backbone",
   "start": 172.46,
   "end": 241,
   "action": "Die Akte: R4 verwirft 203.0.113.0/24 nach Null0 (alte RTBH-Route), R2 fehlt 198.51.100.0/24. Die Nacht geht weiter, die Pakete fallen."
  },
  {
   "id": "C10",
   "title": "Kein Weg",
   "start": 241,
   "end": 259.80097916666665,
   "action": "Titel, zwei letzte Unreachables, dann Stille."
  }
 ],
