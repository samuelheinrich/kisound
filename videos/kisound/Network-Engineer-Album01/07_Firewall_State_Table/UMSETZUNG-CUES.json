 "chapters": [
  {
   "id": "C01",
   "title": "Default deny",
   "start": 0,
   "end": 24.4,
   "action": "Geschlossene Mauer, ruhendes Tor. Die erste Session öffnet sich, ein einzelnes unaufgefordertes Paket stirbt am Tor."
  },
  {
   "id": "C02",
   "title": "Verkehr",
   "start": 24.4,
   "end": 50.6,
   "action": "Der Bass setzt ein: Clients öffnen Sessions, die State Table füllt sich, Rückpakete nehmen den Fast Path. Ein Scanner klopft."
  },
  {
   "id": "C03",
   "title": "Policy und State",
   "start": 50.6,
   "end": 70.74,
   "action": "Default deny, Regeln von oben nach unten, 5-Tupel, TCP-Handshake, UDP ohne Antwort, die Tabelle entscheidet."
  },
  {
   "id": "C04",
   "title": "NAT und Inspection",
   "start": 70.74,
   "end": 78.64,
   "action": "Source NAT versteckt die Inside-Adresse, Destination NAT leitet auf die DMZ, DPI liest mit."
  },
  {
   "id": "C05",
   "title": "Drop it · Log it · Block it",
   "start": 78.64,
   "end": 96.46,
   "action": "Scanner-Welle ohne Bass: verwerfen, loggen, sperren. Ein ACK ohne Session findet keinen Eintrag. Eine neue Regel wird geschrieben."
  },
  {
   "id": "C06",
   "title": "Least privilege",
   "start": 96.46,
   "end": 123.5,
   "action": "Das Tor dreht sich, nur wenige präzise Wege sind offen. Jede Session hinterlässt eine Spur im Log."
  },
  {
   "id": "C07",
   "title": "Übersetzung",
   "start": 123.5,
   "end": 146.92,
   "action": "ACL, NAT-Reflection (Hairpin), Inside local / outside global, DPI: ein sauberer Download passiert, die EICAR-Testsignatur schliesst die Session."
  },
  {
   "id": "C08",
   "title": "Break",
   "start": 146.92,
   "end": 164.78,
   "action": "SYN, ACK, Session match, Deny, Permit, Log, Source NAT, Destination NAT, TCP, UDP – je ein Bild im Kontrollraum."
  },
  {
   "id": "C09",
   "title": "Rausch",
   "start": 164.78,
   "end": 183.1,
   "action": "Volle Fahrt durch das Tor, alle Sessions aktiv."
  },
  {
   "id": "C10",
   "title": "Lock it",
   "start": 183.1,
   "end": 195,
   "action": "Final Hook: Der Scanner stirbt sofort an der Blocklist, die Regel steht."
  },
  {
   "id": "C11",
   "title": "Sessions schliessen",
   "start": 195,
   "end": 259.3209791666667,
   "action": "FIN, Timeouts, die Tabelle leert sich. Kurzer Lichtabfall in der Pegellücke, letzte Fahrt, Titel, zurück zu default deny."
  }
 ],
