 "chapters": [
  {
   "id": "C01",
   "title": "Der Anruf",
   "start": 0,
   "end": 15.08,
   "action": "Nachtstadt, Helpdesk-Telefon; die fehlerhafte Abfrage läuft schon durch die Hierarchie und endet in NXDOMAIN."
  },
  {
   "id": "C02",
   "title": "Symptome",
   "start": 15.08,
   "end": 30.58,
   "action": "Ticket #4040: Ping per IP sauber, Routen gut, nur der Hostname ist weg."
  },
  {
   "id": "C03",
   "title": "Ausschluss",
   "start": 30.58,
   "end": 38.68,
   "action": "Kabel, Port, Firewall, Traceroute: alles grün. Die Lupe landet auf DNS."
  },
  {
   "id": "C04",
   "title": "Hook: Beweise",
   "start": 38.68,
   "end": 48.12,
   "action": "dig, TTL, NXDOMAIN; der Resolver sagt nein, der alte Cache sagt ja."
  },
  {
   "id": "C05",
   "title": "Urteil",
   "start": 48.12,
   "end": 59.58,
   "action": "It’s always DNS: Switch, Router und Firewall entlastet."
  },
  {
   "id": "C06",
   "title": "Indizien",
   "start": 59.58,
   "end": 83.4,
   "action": "Alter Cache mit TTL 86400, Split-Brain der Zonen, Reverse-Lookup ohne PTR, CNAME-Kette."
  },
  {
   "id": "C07",
   "title": "Flush · Query · Dig · Fix",
   "start": 83.4,
   "end": 91.26,
   "action": "Flush hilft nicht allein; dig zeigt die fehlende interne Ansicht; der Eintrag wird ergänzt."
  },
  {
   "id": "C08",
   "title": "Final Hook",
   "start": 91.26,
   "end": 98.2,
   "action": "Dieselben Beweise, jetzt aufgelöst."
  },
  {
   "id": "C09",
   "title": "Fall geschlossen",
   "start": 98.2,
   "end": 121.4,
   "action": "TTL läuft, Final Chorus, Stempel: Fall geschlossen. Licht aus."
  },
  {
   "id": "C10",
   "title": "Nachttour",
   "start": 121.4,
   "end": 182,
   "action": "Rekursive Auflösung durch Root, TLD und autoritative Server; Timeout in der Stille; negative Antworten; Ablauf der TTL."
  },
  {
   "id": "C11",
   "title": "Fallwand",
   "start": 182,
   "end": 203.24,
   "action": "Die Wand mit allen Spuren; das Telefon klingelt wieder."
  },
  {
   "id": "C12",
   "title": "Fall #4041",
   "start": 203.24,
   "end": 226.8,
   "action": "Reprise: intranet → portal → lb, das Ende der CNAME-Kette fehlt."
  },
  {
   "id": "C13",
   "title": "Indizien II",
   "start": 226.8,
   "end": 250.62,
   "action": "Wieder alter Cache, Split-Brain, Reverse, CNAME-Tanz."
  },
  {
   "id": "C14",
   "title": "Fix und Abspann",
   "start": 250.62,
   "end": 258.15,
   "action": "Flush, Query, Dig, Fix; Titel."
  },
  {
   "id": "C15",
   "title": "Fall #4042",
   "start": 258.15,
   "end": 261.2001666666667,
   "action": "Dig it up · TTL · NXDOMAIN – Schnitt."
  }
 ],
