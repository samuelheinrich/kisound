 "chapters": [
  {
   "id": "C01",
   "title": "Die Grenze",
   "start": 0,
   "end": 12.8,
   "action": "Ein grosses Paket fährt an eine kaum sichtbare Grenze und verschwindet in der Pegellücke. Die Rückmeldung stirbt leise an der Firewall."
  },
  {
   "id": "C02",
   "title": "Alles erreichbar",
   "start": 12.8,
   "end": 23.28,
   "action": "Übersicht: Ping geht hin und zurück, kleine Pakete passieren den Tunnel. Der Retransmit wartet und scheitert wieder."
  },
  {
   "id": "C03",
   "title": "Ein Byte zu viel",
   "start": 23.28,
   "end": 37.02,
   "action": "Messhalle: 1401 gegen 1400 Bytes, Header und Nutzlast, DF=1. Dann der stille Drop im Pfad, der Upload steht."
  },
  {
   "id": "C04",
   "title": "Kleine Tests täuschen",
   "start": 37.02,
   "end": 43.7,
   "action": "Ping geht, das grosse Paket stirbt; tracepath endet im Nichts; ein 1400-Byte-Test passt; das Tor wird sichtbar."
  },
  {
   "id": "C05",
   "title": "Das Tor bekommt einen Namen",
   "start": 43.7,
   "end": 48,
   "action": "Kontur gegen Kontur: 100 Bytes Überstand. Der Rahmen rastet ein."
  },
  {
   "id": "C06",
   "title": "M-T-U",
   "start": 48,
   "end": 61.58,
   "action": "Anflug auf das Tor, M-T-U leuchtet rot, das Paket scheitert. Rückzug: die Engstelle ist winzig im ganzen Netz."
  },
  {
   "id": "C07",
   "title": "Don’t fragment",
   "start": 61.58,
   "end": 76,
   "action": "DF-Klammer, enger Korridor von oben, gestrandetes Paket, Vorschau kleinerer Pakete am Sender."
  },
  {
   "id": "C08",
   "title": "Die Hüllen",
   "start": 76,
   "end": 90.52,
   "action": "Tunnel-Overhead: IPsec-Hülle und MPLS-Labels. Das ICMP-„Fragmentation needed“ entsteht und wird an der Firewall verschluckt."
  },
  {
   "id": "C09",
   "title": "Vermessen",
   "start": 90.52,
   "end": 104.88,
   "action": "1400 passt, 1500 nicht, Jumbo nur im eigenen Netz, Path MTU = kleinster Rahmen. Freigabe für ICMP Typ 3/4; der Sender lernt 1400."
  },
  {
   "id": "C10",
   "title": "Jetzt passt es",
   "start": 104.88,
   "end": 117.8,
   "action": "Gleicher Anflug wie im ersten Chorus, gleiche Torgrösse: neue 1400-Byte-Pakete fliegen durch. Der Upload wird fertig."
  },
  {
   "id": "C11",
   "title": "Finale",
   "start": 117.8,
   "end": 139.00016666666667,
   "action": "Schwebe am Tor, letzte lange Fahrt durch den Tunnel, Titel; das letzte Paket passiert auf dem letzten Impuls."
  }
 ],
