# kisound.ch on nginx (example server block). dist/ is uploaded to /var/www/kisound.ch.
server {
  listen 443 ssl http2;
  server_name kisound.ch www.kisound.ch;
  root /var/www/kisound.ch;
  index index.html;
  # ssl_certificate / ssl_certificate_key: e.g. from certbot

  types { text/javascript js; application/json json; audio/mpeg mp3; image/webp webp; font/ttf ttf; }
  gzip on;
  gzip_types text/css text/javascript application/json image/svg+xml font/ttf;

  location ~* "\.[0-9a-f]{10}\.(js|css|json|mp3|webp|jpg|svg)$" { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location / { try_files $uri $uri/ =404; add_header Cache-Control "no-cache"; }
  location = /.htaccess { deny all; }
}
server { listen 80; server_name kisound.ch www.kisound.ch; return 301 https://kisound.ch$request_uri; }
